# Core
NODE_ENV=development
DATABASE_URL=postgresql://askmehire:askmehire@localhost:5432/askmehire?schema=public
DEFAULT_TENANT_ID=abb9786c-8959-516a-9750-05d508607b84

# Auth (NextAuth v5 JWT credentials). Use at least 32 random bytes in production.
AUTH_SECRET=development-only-change-me-32chars-minimum

# Development only: allow API routes without a browser session (uses DEV_ACTING_USER_ID or seeded super admin).
# AUTH_DEV_BYPASS=1
# DEV_ACTING_USER_ID=

# Optional: async jobs (BullMQ)
REDIS_URL=redis://localhost:6379

# Optional: tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=askmehire

# Optional: S3-compatible object storage (R2/S3)
# AWS_REGION=us-east-1
# S3_BUCKET=askmehire-artifacts
# S3_ENDPOINT=

# Rate limiting (in-memory per Node process unless you swap implementation)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_POINTS=120
RATE_LIMIT_DURATION_SEC=60

# Trust X-Forwarded-For when behind a reverse proxy
TRUST_PROXY=0

# Logging
LOG_LEVEL=debug
