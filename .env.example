# Core
NODE_ENV=development
DATABASE_URL=postgresql://askmehire:askmehire@localhost:5432/askmehire?schema=public
# Supabase (Windows/IPv4): use Session pooler :5432 for DATABASE_URL and DIRECT_URL.
# Direct db.PROJECT_REF.supabase.co is IPv6-only — often fails with Prisma P1001 on IPv4 networks.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public
# DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?schema=public
DEFAULT_TENANT_ID=abb9786c-8959-516a-9750-05d508607b84

# Auth (NextAuth v5 JWT credentials). Use at least 32 random bytes in production.
AUTH_SECRET=development-only-change-me-32chars-minimum
# Public site URL for OAuth browser redirects (required in production behind nginx).
# AUTH_URL=http://localhost:3000
# NEXTAUTH_URL=http://localhost:3000

# Development only: allow API routes without a browser session (uses DEV_ACTING_USER_ID or seeded super admin).
# AUTH_DEV_BYPASS=1
# DEV_ACTING_USER_ID=

# Optional: async jobs (BullMQ)
REDIS_URL=redis://localhost:6379

# Optional: tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=askmehire

# Optional: S3-compatible object storage (R2/S3)
# AWS_REGION=us-east-1
# S3_BUCKET=askmehire-artifacts
# S3_ENDPOINT=

# Rate limiting (in-memory per Node process unless you swap implementation)
RATE_LIMIT_ENABLED=1
RATE_LIMIT_POINTS=120
RATE_LIMIT_DURATION_SEC=60

# Trust X-Forwarded-For when behind a reverse proxy
TRUST_PROXY=0

# Logging
LOG_LEVEL=debug

# Gmail OAuth (optional — Email tab Connect Gmail)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/gmail/callback
# GMAIL_TOKEN_ENCRYPTION_KEY=32-char-minimum-dedicated-key-ok

# Adzuna Jobs API (server-only — Connect in UI reads these; restart after changes)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=us
# ADZUNA_SEARCH_WHERE=
# ADZUNA_SYNC_MAX_PAGES=3

# Greenhouse Job Board (server-only — comma-separated slugs from boards.greenhouse.io/yourcompany)
# GREENHOUSE_BOARD_TOKEN=airbnb,stripe,shopify

# Lever Postings API (server-only)
# Lever Postings API (server-only — comma-separated slugs from jobs.lever.co/yourcompany)
# LEVER_SITE_SLUG=spotify,netflix,leverdemo
# LEVER_POSTINGS_API_BASE=https://api.eu.lever.co

# JSearch via RapidAPI (server-only — Google for Jobs aggregate)
# JSEARCH_RAPIDAPI_KEY=
# JSEARCH_COUNTRY=us
# JSEARCH_SYNC_NUM_PAGES=5

# Jooble REST API (server-only)
# JOOBLE_API_KEY=
# JOOBLE_LOCATION=United States
# Must match website registered at jooble.org/api/about (use production URL even in local dev)
# JOOBLE_REFERER=https://www.askmehire.com/
# JOOBLE_SYNC_MAX_PAGES=3
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=common
# Personal Microsoft accounts only: MICROSOFT_TENANT_ID=consumers
# Register this exact URI in Azure App registration → Authentication → Web redirect URIs:
# MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/outlook/callback
# OUTLOOK_TOKEN_ENCRYPTION_KEY=32-char-minimum-dedicated-key-ok
